{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stiftsarchiv-seitenstetten.github.io/erschliessungsumgebung/schemas/module-config.schema.json",
  "title": "Erschliessungsumgebung Module Configuration v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["config_version", "module", "schema", "storage", "id", "signature", "create", "form", "access", "search", "list", "presets"],
  "properties": {
    "config_version": { "const": 1 },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "access_key", "label", "record_type"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "access_key": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "record_type": { "$ref": "#/$defs/key" },
        "short_label": { "type": ["string", "null"] },
        "category": { "type": ["string", "null"] },
        "icon": { "$ref": "#/$defs/key" },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_dir", "filename"],
      "properties": {
        "data_dir": { "type": "string", "minLength": 1 },
        "filename": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy"],
          "properties": {
            "strategy": { "type": "string", "enum": ["record_id_with_extension"] },
            "extension": { "type": "string", "enum": [".md", ".yaml", ".yml", ".json"] }
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "type": "string", "minLength": 1 }
          }
        },
        "index": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "id": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "prefix", "width"],
      "properties": {
        "strategy": { "type": "string", "enum": ["prefixed_sequence"] },
        "prefix": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1, "maximum": 12 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": true,
      "required": ["strategy"],
      "properties": {
        "strategy": { "type": "string", "enum": ["partitioned_sequence"] },
        "bestand": { "type": "string", "minLength": 1 },
        "objektgruppe": { "type": "string", "minLength": 1 },
        "pattern": { "type": "string", "minLength": 1 },
        "partitions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "status_values": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "create": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_assignment"],
      "properties": {
        "identity_assignment": {
          "type": "string",
          "enum": ["on_create", "reserve_before_create"]
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections"],
      "properties": {
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/section" },
          "minItems": 1
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/field_access" }
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lookup": {
          "type": "array",
          "items": { "$ref": "#/$defs/field_path" },
          "uniqueItems": true
        },
        "fulltext": {
          "type": "array",
          "items": { "$ref": "#/$defs/field_path" },
          "uniqueItems": true
        },
        "filters": {
          "type": "array",
          "items": { "$ref": "#/$defs/search_filter" }
        },
        "default_sort": { "$ref": "#/$defs/default_sort" }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns"],
      "properties": {
        "columns": {
          "type": "array",
          "items": { "$ref": "#/$defs/list_column" },
          "minItems": 1
        },
        "default_sort": { "$ref": "#/$defs/default_sort" }
      }
    },
    "presets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field_path" },
          "uniqueItems": true
        },
        "disabled_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field_path" },
          "uniqueItems": true
        }
      }
    },
    "vocabularies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ui_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": ["string", "null"] },
          "technical_preview": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "role": { "type": "string", "enum": ["ehrenamtlich", "redaktion", "admin"] },
    "roles": {
      "type": "array",
      "items": { "$ref": "#/$defs/role" },
      "uniqueItems": true
    },
    "field_path": { "type": "string", "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+|\\[\\])*$" },
    "widget": {
      "type": "string",
      "enum": ["text", "textarea", "select", "checkbox", "repeater", "date", "date_range", "vocabulary_select"]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "order", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "help": { "type": ["string", "null"] },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/group" }
        },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "order", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "help": { "type": ["string", "null"] },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "widget", "label", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "path": { "$ref": "#/$defs/field_path" },
        "widget": { "$ref": "#/$defs/widget" },
        "label": { "type": "string", "minLength": 1 },
        "help": { "type": ["string", "null"] },
        "order": { "type": "integer", "minimum": 0 },
        "placeholder": { "type": ["string", "null"] },
        "rows": { "type": "integer", "minimum": 1 },
        "presettable": { "type": "boolean" },
        "vocabulary": { "$ref": "#/$defs/key" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/option" },
          "uniqueItems": true
        },
        "item_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": ["string", "number", "integer", "boolean"] },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "field_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view", "edit"],
      "properties": {
        "view": { "$ref": "#/$defs/roles" },
        "edit": { "$ref": "#/$defs/roles" }
      }
    },
    "search_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "label"],
      "properties": {
        "path": { "$ref": "#/$defs/field_path" },
        "label": { "type": "string", "minLength": 1 },
        "widget": { "$ref": "#/$defs/widget" }
      }
    },
    "default_sort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "direction"],
      "properties": {
        "path": { "$ref": "#/$defs/field_path" },
        "direction": { "type": "string", "enum": ["asc", "desc"] }
      }
    },
    "list_column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "path"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/field_path" },
        "sortable": { "type": "boolean" },
        "default_sort": { "type": "string", "enum": ["asc", "desc"] }
      }
    }
  }
}
